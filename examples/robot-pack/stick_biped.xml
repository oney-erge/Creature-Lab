<mujoco model="stick biped">
  <!-- A small two-legged robot for trying robot packs. There is no ground plane here: Creature
       Lab adds the floor. Written for Creature Lab, Apache-2.0. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005"/>

  <default>
    <joint damping="0.1" armature="0.01" actuatorfrcrange="-20 20"/>
    <geom friction="1.0 0.005 0.0001" rgba="0.72 0.76 0.82 1"/>
    <motor ctrlrange="-20 20"/>
  </default>

  <worldbody>
    <body name="trunk" pos="0 0 0.64">
      <freejoint name="root"/>
      <geom name="trunk_box" type="box" size="0.07 0.13 0.10" mass="4.0" rgba="0.35 0.55 0.85 1"/>
      <body name="left_thigh" pos="0 0.075 -0.10">
        <joint name="left_hip_roll" axis="1 0 0" range="-0.6 0.6"/>
        <joint name="left_hip_pitch" axis="0 1 0" range="-1.2 1.2"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.025" mass="0.6"/>
        <body name="left_shin" pos="0 0 -0.25">
          <joint name="left_knee" axis="0 1 0" range="-0.1 1.7"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.02" mass="0.4"/>
          <geom name="left_foot" type="box" pos="0.03 0 -0.262" size="0.07 0.035 0.012" mass="0.2"
                rgba="0.25 0.28 0.33 1"/>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.075 -0.10">
        <joint name="right_hip_roll" axis="1 0 0" range="-0.6 0.6"/>
        <joint name="right_hip_pitch" axis="0 1 0" range="-1.2 1.2"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.025" mass="0.6"/>
        <body name="right_shin" pos="0 0 -0.25">
          <joint name="right_knee" axis="0 1 0" range="-0.1 1.7"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.25" size="0.02" mass="0.4"/>
          <geom name="right_foot" type="box" pos="0.03 0 -0.262" size="0.07 0.035 0.012" mass="0.2"
                rgba="0.25 0.28 0.33 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_roll_motor" joint="left_hip_roll"/>
    <motor name="left_hip_pitch_motor" joint="left_hip_pitch"/>
    <motor name="left_knee_motor" joint="left_knee"/>
    <motor name="right_hip_roll_motor" joint="right_hip_roll"/>
    <motor name="right_hip_pitch_motor" joint="right_hip_pitch"/>
    <motor name="right_knee_motor" joint="right_knee"/>
  </actuator>
</mujoco>
